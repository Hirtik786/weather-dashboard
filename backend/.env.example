PORT=5000
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5000

# Application Security
JWT_SECRET=your_jwt_secret_here_change_in_production
ENCRYPTION_KEY=

# Login with Amazon (LWA) OAuth 2.0 Credentials
# Register a Security Profile at: https://developer.amazon.com -> Login with Amazon
# Set Allowed Return URLs to: http://localhost:5000/api/auth/amazon/callback
# Set Allowed JavaScript Origins to: http://localhost:5000
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REDIRECT_URI=http://localhost:5000/api/auth/amazon/callback
LWA_SCOPE=profile:user_id

# Official Sendbox API Integration
# SENDBOX_MODE: 'real' for live official API, 'mock' for development fallback
SENDBOX_MODE=mock
SENDBOX_API_URL=https://live.sendbox.co
SENDBOX_ACCESS_TOKEN=
SENDBOX_CLIENT_ID=
SENDBOX_CLIENT_SECRET=
SENDBOX_APP_ID=
